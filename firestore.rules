rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('preferredLanguage' in data) || data.preferredLanguage == null || (data.preferredLanguage is string && data.preferredLanguage.size() <= 10)) &&
             (!('themeMode' in data) || data.themeMode == null || (data.themeMode is string && data.themeMode.size() <= 20));
    }

    function isValidVehicle(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.make is string && data.make.size() > 0 && data.make.size() <= 100 &&
             data.model is string && data.model.size() > 0 && data.model.size() <= 100 &&
             data.year is int && data.year >= 1900 && data.year <= 2100 &&
             (!('licensePlate' in data) || data.licensePlate == null || (data.licensePlate is string && data.licensePlate.size() <= 50)) &&
             (!('vin' in data) || data.vin == null || (data.vin is string && data.vin.size() <= 50)) &&
             (!('engine' in data) || data.engine == null || (data.engine is string && data.engine.size() <= 100)) &&
             (!('currentMileageKm' in data) || data.currentMileageKm == null || data.currentMileageKm is int);
    }

    function isValidScanRecord(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.vehicleId is string && data.vehicleId.size() > 0 && data.vehicleId.size() <= 128 &&
             data.dtcCodes is string && data.dtcCodes.size() <= 1000 &&
             data.dtcCount is int && data.dtcCount >= 0 && data.dtcCount <= 100 &&
             data.milStatus is bool &&
             data.healthSummaryTh is string && data.healthSummaryTh.size() <= 2000 &&
             data.healthSummaryEn is string && data.healthSummaryEn.size() <= 2000 &&
             data.rpm is int && data.rpm >= 0 && data.rpm <= 50000 &&
             data.coolantTempC is int && data.coolantTempC >= -50 && data.coolantTempC <= 250 &&
             data.speedKmh is int && data.speedKmh >= 0 && data.speedKmh <= 500 &&
             data.batteryVoltage is number && data.batteryVoltage >= 0 && data.batteryVoltage <= 100;
    }

    function isValidMaintenanceLog(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.vehicleId is string && data.vehicleId.size() > 0 && data.vehicleId.size() <= 128 &&
             data.serviceTypeTh is string && data.serviceTypeTh.size() <= 200 &&
             data.serviceTypeEn is string && data.serviceTypeEn.size() <= 200 &&
             data.mileageAtServiceKm is int && data.mileageAtServiceKm >= 0 &&
             data.nextServiceMileageKm is int && data.nextServiceMileageKm >= 0 &&
             data.costThb is number && data.costThb >= 0 &&
             data.garageNameTh is string && data.garageNameTh.size() <= 200 &&
             data.notes is string && data.notes.size() <= 2000 &&
             data.isCompleted is bool;
    }

    function isValidTelemetrySnapshot(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.vehicleName is string && data.vehicleName.size() <= 200 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.reason is string && data.reason.size() <= 2000 &&
             data.speedKmh is int && data.speedKmh >= 0 && data.speedKmh <= 500 &&
             data.rpm is int && data.rpm >= 0 && data.rpm <= 50000 &&
             data.coolantTempC is int && data.coolantTempC >= -50 && data.coolantTempC <= 250 &&
             data.intakeAirTempC is int && data.intakeAirTempC >= -50 && data.intakeAirTempC <= 250 &&
             data.boostPressureBar is number && data.boostPressureBar >= -5 && data.boostPressureBar <= 20 &&
             data.mafGps is number && data.mafGps >= 0 && data.mafGps <= 1000 &&
             data.throttlePercent is number && data.throttlePercent >= 0 && data.throttlePercent <= 100 &&
             data.batteryVoltage is number && data.batteryVoltage >= 0 && data.batteryVoltage <= 100 &&
             data.activeDtcs is string && data.activeDtcs.size() <= 1000 &&
             data.notes is string && data.notes.size() <= 2000;
    }

    // Match users collection
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       (!('createdAt' in incoming()) || (incoming().createdAt is timestamp && incoming().createdAt <= request.time)) &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // Subcollection: vehicles
      match /vehicles/{vehicleId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(vehicleId) &&
                         incoming().userId == request.auth.uid &&
                         (!('createdAt' in incoming()) || (incoming().createdAt is timestamp && incoming().createdAt <= request.time)) &&
                         isValidVehicle(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(vehicleId) &&
                         incoming().userId == existing().userId &&
                         isValidVehicle(incoming());
        allow delete: if isOwner(userId) && isValidId(vehicleId);
      }

      // Subcollection: scan_records
      match /scan_records/{scanRecordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(scanRecordId) &&
                         incoming().userId == request.auth.uid &&
                         (!('createdAt' in incoming()) || (incoming().createdAt is timestamp && incoming().createdAt <= request.time)) &&
                         isValidScanRecord(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(scanRecordId) &&
                         incoming().userId == existing().userId &&
                         isValidScanRecord(incoming());
        allow delete: if isOwner(userId) && isValidId(scanRecordId);
      }

      // Subcollection: maintenance_logs
      match /maintenance_logs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().userId == request.auth.uid &&
                         (!('createdAt' in incoming()) || (incoming().createdAt is timestamp && incoming().createdAt <= request.time)) &&
                         isValidMaintenanceLog(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().userId == existing().userId &&
                         isValidMaintenanceLog(incoming());
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Subcollection: telemetry_snapshots
      match /telemetry_snapshots/{snapshotId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(snapshotId) &&
                         incoming().userId == request.auth.uid &&
                         (!('createdAt' in incoming()) || (incoming().createdAt is timestamp && incoming().createdAt <= request.time)) &&
                         isValidTelemetrySnapshot(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(snapshotId) &&
                         incoming().userId == existing().userId &&
                         isValidTelemetrySnapshot(incoming());
        allow delete: if isOwner(userId) && isValidId(snapshotId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
